.DS_Store
.cursor
.claude

# Rendered tool skills — produced per-project by setup-*.sh scripts.
# These are user-configured artefacts, not submodule-tracked content.
skills/github-projects/
skills/jira/
skills/google-analytics/
skills/figma/
skills/model-router/

# Vendored upstream skill — fetched from figma/mcp-server-guide by setup-figma.sh.
skills/figma-use/

# Antigravity reads its project MCP config from .agents/, which is this checkout.
# Generated per project by the harness adapters (scripts/lib/harness.sh).
mcp_config.json

# Installed-tools manifest — per-checkout state written by setup-*.sh, read by
# doctor.sh. Not submodule-tracked content.
.manifest.local.yml
# --- byrde-agents ---
.claude/*
!.claude/memory/
.worktrees/
.claude/
.cursor/
.mcp.json
.workspace.agents.json
# --- end byrde-agents ---
